---
const { class: className, ...props } = Astro.props

---
<div class:list={[ "container", className ]} {...props}>
  <slot />
</div>

<style scoped>
  .container {
    width: 100%;
    max-width: var(--container-width);
    padding: 0px var(--container-padding);
    margin: 0px auto;
  }
</style>
