---
import { isNumber, isString } from '@/shared/utils/types'
import { first } from '@/shared/utils/logic'

export type IconSize = 's' | 'm' | 'l'

const mapSizeToDimension: Record<IconSize, number> = {
  s: 16,
  m: 24,
  l: 32,
}

const DEFAULT_SIZE = 'm'

interface Props {
  name: string
  class?: string
  size?: IconSize | number
  viewBox?: number
}

const { 
  name,
  class: className, 
  size,
  viewBox,
  ...props
} = Astro.props

const dimension = first([
  [ isNumber(size), () => size ],
  [ isString(size), () => mapSizeToDimension[size as IconSize] ],
  [ isNumber(viewBox), () => viewBox ]
], mapSizeToDimension[DEFAULT_SIZE])

const viewBoxSize = isNumber(viewBox) ? viewBox : dimension

const styles = {
  '--size': `${dimension}px`
}

---
<svg
  class:list={[ "icon", className ]}
  viewBox={`0 0 ${viewBoxSize} ${viewBoxSize}`}
  style={styles}
  {...props}
>
  <use href={`icons.svg#${name}`} />
</svg>

<style scoped>
  .icon {
    display: block;
    width: var(--size);
    height: var(--size);
    flex: 0 0 var(--size);
  }
</style>