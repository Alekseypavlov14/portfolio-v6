---
export type IconSize = 's' | 'm' | 'l'

const mapSizeToDimension: Record<IconSize, number> = {
  s: 16,
  m: 24,
  l: 32,
}

interface Props {
  name: string
  class?: string
  size?: IconSize
}

const { 
  name,
  class: className, 
  size = 'm',
  ...props
} = Astro.props

const dimension = mapSizeToDimension[size]

const styles = {
  '--size': `${dimension}px`
}

---
<svg
  class:list={[ "icon", className ]}
  viewBox="0 0 24 24"
  style={styles}
  {...props}
>
  <use href={`icons.svg#${name}`} />
</svg>

<style scoped>
  .icon {
    display: block;
    width: var(--size);
    height: var(--size);
    flex: 0 0 var(--size);
  }
</style>