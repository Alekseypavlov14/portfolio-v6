---
import Layout from '@/components/Layout.astro'
import Header from '@/widgets/shared/Header.astro'
import Footer from '@/widgets/shared/Footer.astro'

import ProjectPresentationPreview from '@/widgets/presentations/ProjectPresentationPreview.astro'
import ProjectPresentationPages from '@/widgets/presentations/ProjectPresentationPages.astro'

import type { GetStaticPathsItem, GetStaticPathsResult } from 'astro'
import type { ProjectPresentation } from '@/data/presentations'
import { getPresentation, hasPresentation } from '@/features/presentations'
import { projects, type Project } from '@/data/projects'

export function getStaticPaths(): GetStaticPathsResult {
	return projects
		.filter(project => hasPresentation(project.slug))
		.map<GetStaticPathsItem>(project => ({
			params: { 
				slug: project.slug 
			},
			props: { 
				project: project,
				presentation: getPresentation(project.slug),
			},
		}))
}

const project: Project = Astro.props.project as Project
const presentation: ProjectPresentation = Astro.props.presentation as ProjectPresentation

---
<Layout>
	<Header positionStatic />

	<ProjectPresentationPreview project={project} />
	<ProjectPresentationPages 
		project={project}
		presentation={presentation}
	/>

	<Footer />
</Layout>
