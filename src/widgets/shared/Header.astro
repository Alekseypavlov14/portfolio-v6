---
import Container from '@/components/Container.astro'
import Link from '@/components/Link.astro'
import Social from './Social.astro'

export interface Props {
  positionStatic?: boolean
}

const positionStatic = Astro.props.positionStatic

---
<header class:list={["header", positionStatic && 'static']}>
  <Container class="header__container">
    <nav class="header__nav">
      <Link href="/#home" class="header__nav-link">HOME</Link>
      <Link href="/#works" class="header__nav-link">WORKS</Link>
      <Link href="/#about" class="header__nav-link">ABOUT</Link>
    </nav>

    <Social class="header__social" />

    <div id="burger" class="burger">
      <div class="burger__line"></div>
      <div class="burger__line"></div>
    </div>
  </Container>

  <aside id="sidebar" class="sidebar">
    <Container class="sidebar__container">
      <div class="sidebar__top">
        <nav class="sidebar__nav">
          <a href="/#home" class="sidebar__nav-link">Home</a>
          <a href="/#works" class="sidebar__nav-link">Works</a>
          <a href="/#about" class="sidebar__nav-link">About</a>
        </nav>
      </div>

      <div class="sidebar__bottom">
        <hr class="sidebar__separation">
        <Social class="sidebar__social" />
      </div>
    </Container>
  </aside>
</header>

<script>
  const sidebar = document.getElementById('sidebar')!
  const burger = document.getElementById('burger')!

  const links: Array<HTMLElement> = Array.from(document.querySelectorAll('.sidebar__nav-link'))

  const sidebarOpenedClass = 'opened'
  const burgerOpenedClass = 'opened'
  const bodyFixedClass = 'fixed'

  burger.addEventListener('click', () => {
    document.body.classList.toggle(bodyFixedClass)
    sidebar.classList.toggle(sidebarOpenedClass)
    burger.classList.toggle(burgerOpenedClass)
  })

  links.forEach(link => {
    link.addEventListener('click', () => {
      document.body.classList.remove(bodyFixedClass)
      sidebar.classList.remove(sidebarOpenedClass)
      burger.classList.remove(burgerOpenedClass)
    })
  })
</script>

<style is:global>
  body.fixed {
    overflow: hidden;
  }

  .header {
    width: 100%;
    padding: 30px 0px;

    position: absolute;
    z-index: var(--z-index-header);
    top: 0;
  }
  .header.static {
    position: relative;
  }
  .header__container {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: 40px;
  }
  .header__nav-link {
    font-size: 20px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .header__social {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .burger {
    --size: 40px;
    --line: 24px;
    --gap: 8px;

    height: var(--size);
    width: var(--size);
    flex: 0 0 var(--size);

    position: relative;
    z-index: var(--z-index-header);

    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 8px;

    display: none;
  }
  .burger__line {
    width: var(--line);
    border: 1px solid var(--base-400);
    transition: 0.3s;
  }
  .burger__line:last-child {
    width: calc(var(--line) / 2);
  }
  .burger.opened .burger__line {
    border-color: var(--base-100);
  }
  .burger.opened .burger__line:last-child {
    width: var(--line);
  }

  .sidebar {
    display: none;

    width: 100%;
    height: 100%;
    background-color: var(--base-900);

    padding-top: 70px;
    padding-bottom: 20px;

    position: fixed;
    top: 0;
    left: 0;
    z-index: var(--z-index-sidebar);

    display: flex;
    flex-direction: column;
    
    transition: 0.7s;
  }
  .sidebar:not(.opened) {
    transform: translateY(-110%);
  }

  .sidebar__container {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
  }
  .sidebar__top {
    flex: 1 1 auto;
    padding-top: 70px;
  }
  .sidebar__nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
  }
  .sidebar__nav-link {
    font-size: 36px;
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .sidebar__separation {
    border: none;
    border-top: 1px solid var(--base-500);
    width: 80%;
  }
  .sidebar__bottom {
    padding-bottom: 30px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 30px;
  }

  @media (max-width: 500px) {
    .header {
      position: relative;
      padding-block: 15px;
    }
    .header__container {
      justify-content: flex-end;
    }

    .header__nav {
      display: none;
    }
    .header__social {
      display: none !important;
    }

    .burger {
      display: flex;
    }
    .sidebar {
      display: flex;
    }
  }
</style>