---
import Container from '@/components/Container.astro'
import Icon from '@/components/Icon.astro'
import Link from '@/components/Link.astro'

---

<header class="header">
  <Container class="header__container">
    <nav class="nav">
      <Link href="#home" class="nav__link">HOME</Link>
      <Link href="#works" class="nav__link">WORKS</Link>
      <Link href="#about" class="nav__link">ABOUT</Link>
    </nav>

    <div class="social">
      <Link href="#" class="social__link">
        <Icon name="linkedin"></Icon>
      </Link>
      <Link href="#" class="social__link">
        <Icon name="whatsapp"></Icon>
      </Link>
      <Link href="#" class="social__link">
        <Icon name="telegram"></Icon>
      </Link>
      <Link href="#" class="social__link">
        <Icon name="mail"></Icon>
      </Link>
    </div>
  </Container>
</header>

<style is:global>
  .header {
    width: 100%;
    padding: 30px 0px;

    position: absolute;
    z-index: var(--z-index-header);
    top: 0;
  }
  .header__container {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 40px;
  }
  .nav__link {
    font-size: 20px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--base-100);
  }

  .social {
    display: flex;
    align-items: center;
    gap: 10px;
  }
</style>