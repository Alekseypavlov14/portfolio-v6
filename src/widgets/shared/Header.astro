---
import Container from '@/components/Container.astro'
import Icon from '@/components/Icon.astro'
import Link from '@/components/Link.astro'

---

<header class="header">
  <Container class="header__container">
    <nav class="header__nav">
      <Link href="#home" class="header__nav-link">HOME</Link>
      <Link href="#works" class="header__nav-link">WORKS</Link>
      <Link href="#about" class="header__nav-link">ABOUT</Link>
    </nav>

    <div class="header__social">
      <Link href="#" class="social__link">
        <Icon name="linkedin"></Icon>
      </Link>
      <Link href="#" class="social__link">
        <Icon name="whatsapp"></Icon>
      </Link>
      <Link href="#" class="social__link">
        <Icon name="telegram"></Icon>
      </Link>
      <Link href="#" class="social__link">
        <Icon name="mail"></Icon>
      </Link>
    </div>

    <div class="burger">
      <div class="burger__line"></div>
      <div class="burger__line"></div>
    </div>
  </Container>
</header>

<style is:global>
  .header {
    width: 100%;
    padding: 30px 0px;

    position: absolute;
    z-index: var(--z-index-header);
    top: 0;
  }
  .header__container {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: 40px;
  }
  .header__nav-link {
    font-size: 20px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .header__social {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .burger {
    --size: 40px;
    --line: 24px;

    height: var(--size);
    width: var(--size);
    flex: 0 0 var(--size);

    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 8px;

    display: none;
  }
  .burger__line {
    width: var(--line);
    border: 1px solid var(--base-400);
  }

  @media (max-width: 500px) {
    .header {
      padding-block: 15px;
    }
    .header__container {
      justify-content: flex-end;
    }

    .header__nav {
      display: none;
    }
    .header__social {
      display: none;
    }

    .burger {
      display: flex;
    }
  }
</style>