---
import Icon, { type IconSize } from '@/components/Icon.astro'
import Link from '@/components/Link.astro'

interface Props {
  class?: string
  size?: IconSize
}

const { size, class: className } = Astro.props

---
<div class:list={[ "social", className ]}>
  <Link href="https://linkedin.com/in/pavlov-oleksii" class="social__link" target="_blank">
    <Icon name="linkedin" size={size}></Icon>
  </Link>
  <Link href="https://wa.me/40739521908" class="social__link" target="_blank">
    <Icon name="whatsapp" size={size}></Icon>
  </Link>
  <Link href="https://t.me/aleshapavlov14" class="social__link" target="_blank">
    <Icon name="telegram" size={size}></Icon>
  </Link>
  <Link href="mailto:aleshapavlov9@gmail.com" class="social__link" target="_blank">
    <Icon name="mail" size={size}></Icon>
  </Link>
  <Link href="https://github.com/Alekseypavlov14" class="social__link" target="_blank">
    <Icon name="github" size={size}></Icon>
  </Link>
</div>

<style>
  .social {
    display: flex;
    align-items: center;
    gap: 10px;
  }
</style>
