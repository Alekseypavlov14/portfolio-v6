---
import Container from '@/components/Container.astro'

import { projects } from '@/data/projects'

---
<section id="works" class="projects">
  <Container class="projects__container">
    <div class="projects__slider">
      <div class="projects__slides">
        {projects.map((project) => (
          <div id={project.slug} data-project class="project">
            <div class="project__content">
              <a href={project.link} class="project__image" target="_blank">
                {project.image ? <img src={project.image} /> : ''}
              </a>
        
              <div class="project__text">
                <a href={project.link} class="project__title" target="_blank">{project.title}</a>
        
                <div class="project__info">
                  <span class="project__date">{project.date}</span>
                  <span class="project__separation">|</span>
                  <span class="project__technologies">{project.technologies}</span>
                </div>
        
                <p class="project__description">
                  {project.description}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>
  
      <div class="projects__nav">
        <div class="projects__nav-links">
          {projects.map((project) => (
            <a 
              href={`#${project.slug}`} 
              class="projects__nav-link"
              data-project-link 
            />
          ))}
        </div>
        <div class="projects__nav-terminator" />
      </div>
    </div>
  </Container>
</section>

<script>
  import { findMaxIndex, normalize } from '@/shared/utils/math'

  const projects: Array<HTMLElement> = Array.from(document.querySelectorAll('[data-project]'))
  const projectLinks: Array<HTMLElement> = Array.from(document.querySelectorAll('[data-project-link]'))

  const opacityAdjustExponential = 4
  const opacityAdjustCoefficient = 2

  const projectLinkActiveClass = 'active'

  updateSlider()
    
  window.addEventListener('scroll', updateSlider)
  window.addEventListener('resize', updateSlider)

  function updateSlider() {
    if (!projects.length || !projectLinks.length || projects.length !== projectLinks.length) return

    const positionRatios = projects.map(project => {
      const projectTop = Math.abs(project.getBoundingClientRect().top)
      const positionRatio = normalize(1 - projectTop / window.innerHeight)
      return positionRatio
    })
    
    const opacityRatios = positionRatios.map(position => {
      const opacityRatio = (position ** opacityAdjustExponential) * opacityAdjustCoefficient
      return normalize(opacityRatio)
    })

    projects.forEach((project, index) => {
      project.style.opacity = String(opacityRatios[index])
    })
    
    const maxOpacityIndex = findMaxIndex(opacityRatios)

    projectLinks.forEach(link => link.classList.remove(projectLinkActiveClass))
    projectLinks[maxOpacityIndex].classList.add(projectLinkActiveClass)
  }
</script>

<style is:global>
  .projects {
    width: 100%;

    --card-gap: 80px;
    --nav-gap: 80px;
    --nav-size: 10px;
  }

  .projects__slider {
    display: flex;
    gap: var(--nav-gap);
  }
  .projects__slides {
    width: 100%;
    flex: 1 1 auto;
    padding-left: calc(var(--nav-size) + var(--nav-gap));
  }
  .projects__nav {
    flex: 0 0 var(--nav-size);
  }
  .projects__nav-links {
    width: 100%;
    position: sticky;
    min-height: 100svh;
    top: 0;

    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 20px;
  }
  .projects__nav-link {
    flex: 0 0 var(--nav-size);
    width: var(--nav-size);
    height: var(--nav-size);
    border-radius: var(--nav-size);
    background-color: var(--base-700);
    transition: 0.3s;
  }
  .projects__nav-link.active {
    background-color: var(--base-500);
  }
  .projects__nav-terminator {
    position: sticky;
    top: 0;
  }

  .project {
    min-height: 100vh;
    width: 100%;

    display: flex;
    align-items: center;
    transform-origin: center;
  }
  .project__content {
    width: 100%;
    padding: 80px 0px;

    display: flex;
    justify-content: space-between;
    gap: var(--card-gap);
  }
  .project__image {
    flex: 0 0 40%;
    width: 100%;
    min-height: 200px;
    aspect-ratio: 16 / 9;
    background-color: var(--base-800);
  }
  .project__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .project__text {
    width: 100%;
    flex: 1 1 auto;
  }
  .project__title {
    font-size: 50px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.07em;
    color: var(--base-200);
  }
  .project__info {
    margin-top: 15px;
    display: flex;
    gap: 20px;

    font-size: 20px;
    letter-spacing: -0.07em;
    color: var(--base-400);
    line-height: 1.2;
  }
  .project__separation {
    color: var(--base-500);
  }
  .project__description {
    margin-top: 30px;
    width: 100%;

    font-size: 20px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.03em;
    color: var(--base-400);
    text-align: justify;
  }

  @media (max-width: 600px) {
    .projects {
      --nav-gap: 20px;
      --card-gap: 20px;
    }
    .projects__slides {
      padding-left: 0px;
    }

    .project {
      min-height: 0px;
      opacity: 1 !important;
    }
    .project__content {
      padding: 40px 0px;
      flex-direction: column;
    }
    .project__title {
      font-size: 24px;
    }
    .project__info {
      margin-top: 10px;
      gap: 10px;
    }
    .project__date {
      font-size: 12px;
      letter-spacing: -0.03em;
    }
    .project__separation {
      font-size: 15px;
      line-height: 1.2;
    }
    .project__technologies {
      font-size: 12px;
      letter-spacing: -0.03em;
    }
    .project__description {
      margin-top: 15px;
      font-size: 14px;
      text-align: left;
      text-wrap: balance;
    }
  }
</style>