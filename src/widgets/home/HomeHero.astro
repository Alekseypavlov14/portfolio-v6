---
import Container from '@/components/Container.astro'

---

<main id="home" class="hero">
  <div class="hero__image">
    <img src="/images/hero-desktop.png" class="hero__image">
  </div>

  <Container class="hero__container">
    <div class="hero__content">
      <div class="hero__top">
        <h2 class="hero__pretitle">Hi, I am Alex,</h2>
        <h1 class="hero__title">Frontend Developer</h1>
        <hr class="hero__decor">
      </div>

      <div class="hero__bottom">
        <span class="hero__copyright">&copy; Oleksii Pavlov</span>
      </div>
    </div>
  </Container>
</main>

<style is:global>
  .hero {
    width: 100%;
    height: 100dvh;
    position: relative;

    --image-width: 55vw;
  }

  .hero__image {
    position: absolute;
    right: 0;
    top: 0;

    height: 100%;
    width: var(--image-width);
  
    overflow: hidden;
  }
  .hero__image img {
    display: block;
    width: 100%;
    height: auto;
  }
  
  .hero__container {
    height: 100%;
  }
  .hero__content {
    height: 100%;
    width: calc(100% - var(--image-width) + var(--container-margin) + var(--container-padding));

    display: flex;
    flex-direction: column;

    position: relative;
    z-index: var(--z-index-hero);
  }
  .hero__top {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero__pretitle {
    font-size: 32px;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--base-100);
  }
  .hero__title {
    font-family: 'Barlow Condensed', 'Inter', sans-serif;
    text-transform: uppercase;
    font-size: 64px;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--base-100);
  }
  .hero__decor {
    margin-top: 20px;
    display: block;
    border: 1px solid var(--base-400);
    width: 65%;
  }

  .hero__bottom {
    padding: 20px 0px;
  }
  .hero__copyright {
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.03em;
  }
</style>
